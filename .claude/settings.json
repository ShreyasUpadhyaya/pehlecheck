{
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(pytest:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Edit(REVIEW.md)",
      "Write(REVIEW.md)"
    ],
    "deny": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git checkout:*)",
      "Bash(git reset:*)",
      "Bash(git stash:*)",
      "Bash(pip install:*)",
      "Bash(npm install:*)"
    ]
  }
}
